{
  "@udt": "Yggdrasil.UDT.File",
  "@v": "1.0.0",
  "@t": 85,
  "description": "File header UDT with versioning",
  "schema": {
    "@udt": "string",
    "@v": "semver",
    "@t": "number",
    "@p": "string|null",
    "@r": ["string"],
    "@s": "draft|active|deprecated"
  },
  "format": "{ \"@udt\": \"ID\", \"@v\": \"1.0.0\", \"@t\": 50, \"@p\": \"Parent\", \"@r\": [], \"@s\": \"active\" }",
  "statuses": {
    "draft": "In development, may change",
    "active": "Stable, production ready",
    "deprecated": "Scheduled for removal"
  },
  "maxTokens": 250
}
